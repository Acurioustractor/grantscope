#!/bin/sh
# GrantScope pre-commit hook
#
# Runs two checks on staged content:
#   1. Secret scan — blocks well-known token formats (Notion, Anthropic,
#      OpenAI, Slack, GitHub, AWS, Supabase service keys, Stripe). Catches
#      the class of incident that bit us 2026-05-16 (a Notion token in a
#      handoff ledger blocked the push at GitHub's secret-scanner — fine,
#      but caught much later than ideal).
#   2. Type check — runs `cd apps/web && npx tsc --noEmit` if any .ts/.tsx
#      file is staged. Matches CLAUDE.md Rule #3.
#
# Install: ln -sf ../../scripts/git-hooks/pre-commit .git/hooks/pre-commit
# Skip (emergencies only): git commit --no-verify

set -e

RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
RESET='\033[0m'

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED" ] && exit 0

# ── 1. Secret scan ──────────────────────────────────────────────────────────
# Patterns intentionally tight — false positives are worse than misses here
# because devs will start using --no-verify. Each pattern targets the actual
# token prefix or structure, not just the word "token".
PATTERNS=$(cat <<'EOF'
ntn_[A-Za-z0-9]{40,}
sk-ant-[A-Za-z0-9_-]{30,}
sk-(proj-)?[A-Za-z0-9_-]{30,}
xoxb-[0-9]{10,}-[0-9]{10,}-[A-Za-z0-9]{20,}
xoxp-[0-9]{10,}-[0-9]{10,}-[0-9]{10,}-[A-Za-z0-9]{30,}
ghp_[A-Za-z0-9]{36}
gho_[A-Za-z0-9]{36}
github_pat_[A-Za-z0-9_]{82}
AKIA[0-9A-Z]{16}
eyJhbGciOi[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{50,}\.[A-Za-z0-9_-]{20,}
sk_live_[A-Za-z0-9]{24,}
rk_live_[A-Za-z0-9]{24,}
EOF
)

LEAK_FOUND=0
LEAK_REPORT=""

for FILE in $STAGED; do
  # Skip binary files + .env / known-gitignored config
  case "$FILE" in
    *.env|*.env.*|*.png|*.jpg|*.jpeg|*.gif|*.pdf|*.zip|*.lock|package-lock.json|pnpm-lock.yaml|yarn.lock)
      continue
      ;;
  esac
  [ -f "$FILE" ] || continue

  while IFS= read -r PATTERN; do
    [ -z "$PATTERN" ] && continue
    HITS=$(git diff --cached -U0 "$FILE" 2>/dev/null | grep -nE "^\+" | grep -E "$PATTERN" || true)
    if [ -n "$HITS" ]; then
      LEAK_FOUND=1
      LEAK_REPORT="${LEAK_REPORT}\n${RED}✗ $FILE${RESET} matches pattern ${YELLOW}$PATTERN${RESET}\n$(echo "$HITS" | head -3 | sed 's/^/    /')\n"
    fi
  done <<EOF2
$PATTERNS
EOF2
done

if [ $LEAK_FOUND -eq 1 ]; then
  printf "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
  printf "${RED}  Commit blocked: secret-like patterns detected${RESET}\n"
  printf "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
  printf "%b" "$LEAK_REPORT"
  printf "\n${YELLOW}If this is a false positive, you can:${RESET}\n"
  printf "  1. Refactor to read from process.env instead\n"
  printf "  2. Move the value to .env (gitignored)\n"
  printf "  3. \`git commit --no-verify\` to bypass (last resort — rotation required if it leaks)\n\n"
  exit 1
fi

# ── 2. Type check (only if .ts/.tsx files are staged) ─────────────────────
TS_STAGED=$(echo "$STAGED" | grep -E '\.(ts|tsx)$' | grep -v '\.next/' || true)
if [ -n "$TS_STAGED" ]; then
  printf "${YELLOW}Running tsc --noEmit…${RESET}\n"
  if ! (cd apps/web && npx tsc --noEmit) 2>&1 | tail -20; then
    printf "\n${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
    printf "${RED}  Commit blocked: TypeScript errors${RESET}\n"
    printf "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
    exit 1
  fi
fi

printf "${GREEN}✓ pre-commit checks passed${RESET}\n"
exit 0
