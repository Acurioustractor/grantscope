{
  "installCommand": "pnpm install",
  "buildCommand": "cd apps/web && NODE_OPTIONS=--max-old-space-size=4096 pnpm run build",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",
  "regions": ["syd1"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "grantscope.vercel.app" }],
      "destination": "https://civicgraph.app/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/civicscope/cron?mode=statements",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/civicscope/cron?mode=crosslink",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/civicscope/cron?mode=commitments",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/civicscope/cron?mode=hansard",
      "schedule": "0 4 * * 0"
    },
    {
      "path": "/api/civicscope/digest?period=daily",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/civicscope/cron?mode=telegram",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/reports/youth-justice/qld/watchhouse-data/refresh",
      "schedule": "10 8 * * *"
    },
    {
      "path": "/api/reports/youth-justice/qld/watchhouse-data/refresh",
      "schedule": "10 20 * * *"
    },
    {
      "path": "/api/cron/desk-digest",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/usage-alerts",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/funding-weekly-digest",
      "schedule": "0 0 * * 1"
    }
  ]
}
